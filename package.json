{
  "name": "tech-news-digest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "毎朝のテックニュースを日本語で要約して静的ページにまとめる個人用ツール",
  "scripts": {
    "build": "tsx src/main.ts",
    "build:offline": "tsx src/main.ts --offline",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "notify:success": "tsx src/notify.ts success",
    "notify:failure": "tsx src/notify.ts failure",
    "resend:status": "tsx src/resend-status.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.25.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.1.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
